<?xml version="1.0" encoding="utf-8"?>
<!--
  IIS settings for the API (ignored when running on Kestrel). The publish step fills in the launcher placeholders.
  - httpErrors PassThrough: IIS never replaces the API's JSON errors with its own HTML pages (D-032).
  - maxAllowedContentLength 21 MB: photo uploads (20 MB + multipart overhead, D-042); every other endpoint is
    still limited to 1 MB by the API itself.
  Secrets (connection string, first-admin seed) are NOT set here: use server environment variables (DEPLOYMENT.md).
-->
<configuration>
  <location path="." inheritInChildApplications="false">
    <system.webServer>
      <handlers>
        <add name="aspNetCore" path="*" verb="*" modules="AspNetCoreModuleV2" resourceType="Unspecified" />
      </handlers>
      <aspNetCore processPath="%LAUNCHER_PATH%" arguments="%LAUNCHER_ARGS%" stdoutLogEnabled="false" stdoutLogFile=".\logs\stdout" hostingModel="inprocess" />
      <httpErrors existingResponse="PassThrough" />
      <security>
        <requestFiltering>
          <requestLimits maxAllowedContentLength="22020096" />
        </requestFiltering>
      </security>
    </system.webServer>
  </location>
</configuration>
