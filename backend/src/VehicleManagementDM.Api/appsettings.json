{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning",
      "Microsoft.AspNetCore.Diagnostics.ExceptionHandlerMiddleware": "None",
      "Microsoft.EntityFrameworkCore.Database.Command": "Warning",
      "Microsoft.EntityFrameworkCore.Migrations": "Information"
    }
  },
  "AllowedHosts": "*",
  "ConnectionStrings": {
    "Default": ""
  },
  "Errors": {
    "IncludeExceptionDetails": false
  },
  "ErrorLogging": {
    "FallbackDirectory": "App_Data/logs",
    "RetentionDays": 30
  },
  "Storage": {
    "RootPath": "App_Data/files",
    "MaxPhotoBytes": 20971520,
    "MaxSignatureBytes": 524288
  },
  "Auth": {
    "SessionHours": 12,
    "RememberMeDays": 30,
    "MaxFailedLogins": 5,
    "LockoutMinutes": 15,
    "LoginAttemptsPerMinute": 10
  },
  "DataProtection": {
    "KeysPath": ""
  },
  "Swagger": {
    "Enabled": false
  }
}
